# Copy to .env for local runs. Never commit .env.
# The engine reads these from process.env directly, in this order:
# JEV_API_KEY first, else TYPESAFE_API_KEY, else AI_GATEWAY_API_KEY,
# else VERCEL_OIDC_TOKEN (see README "API keys and environment").
JEV_API_KEY=
TYPESAFE_API_KEY=
AI_GATEWAY_API_KEY=
VERCEL_OIDC_TOKEN=
