{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "jev-pref project-defined semantic checks",
  "type": "object",
  "properties": {
    "suites": { "type": "array", "items": { "type": "string" }, "default": ["prefs"] },
    "gateThreshold": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.7 },
    "advisoryThreshold": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.7 },
    "failOn": { "type": "string", "enum": ["gates", "all", "never"], "default": "gates" },
    "timeoutMs": { "type": "integer", "minimum": 1, "default": 60000 },
    "maxDiffChars": { "type": "integer", "minimum": 1, "default": 20000, "description": "Maximum diff characters per Jev request; keep conservative for Jev's 30k-token total input limit." },
    "hunks": { "type": "boolean", "default": false },
    "files": { "type": "boolean", "default": false },
    "maxHunks": { "type": "integer", "minimum": 1, "default": 10 },
    "include": { "type": "array", "items": { "type": "string" }, "default": [] },
    "exclude": { "type": "array", "items": { "type": "string" }, "default": [] },
    "agent": {
      "type": ["object", "null"],
      "default": null,
      "properties": {
        "command": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "input": { "type": "string", "enum": ["json", "text", "none"], "default": "json" },
        "on": { "type": "array", "items": { "type": "string", "enum": ["fix_now", "advisory", "approve"] }, "default": ["fix_now"] },
        "timeoutMs": { "type": "integer", "minimum": 1, "default": 300000 }
      },
      "required": ["command"]
    },
    "model": { "type": "string" },
    "baseUrl": { "type": "string" },
    "provider": { "type": "string", "enum": ["typesafe", "vercel"] },
    "zeroDataRetention": { "type": "boolean", "default": false },
    "prefs": {
      "type": "array",
      "default": [],
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["id", "gate"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" },
              "type": { "const": "condition" },
              "gate": { "type": "boolean" },
              "question": { "type": "string", "minLength": 1 },
              "guidance": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1, "description": "Legacy condition wording; prefer question." }
            },
            "anyOf": [{ "required": ["question"] }, { "required": ["text"] }]
          },
          {
            "type": "object",
            "required": ["id", "type", "question", "labels", "outcomes"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" },
              "type": { "const": "choice" },
              "question": { "type": "string", "minLength": 1 },
              "guidance": { "type": "string", "minLength": 1 },
              "labels": {
                "type": "object",
                "minProperties": 2,
                "maxProperties": 255,
                "additionalProperties": { "type": "string", "minLength": 1 }
              },
              "outcomes": {
                "type": "object",
                "additionalProperties": { "type": "string", "enum": ["approve", "advisory", "fix_now"] }
              }
            }
          }
        ]
      }
    }
  }
}
